{
  "name": "@chatbotkit-dev/openapi-types-generator",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "openapi-types-generator": "./bin/cli.ts"
  },
  "scripts": {
    "cli": "pnpm tsx ./bin/cli.ts",
    "build": "true",
    "check": "tsc6 --noEmit --incremental",
    "clean": "run-s clean:*",
    "clean:01-tsbuildinfo": "rimraf *.tsbuildinfo",
    "clean:02-dist": "rimraf dist",
    "clean:03-node_modules": "rimraf node_modules",
    "format": "true",
    "lint": "eslint src --ext .ts,.js,.tsx,.jsx",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "access": "restricted",
  "dependencies": {
    "@types/node": "^24.0.0",
    "commander": "^12.1.0",
    "quicktype-core": "^23.0.170",
    "swagger-client": "^3.31.1"
  },
  "devDependencies": {
    "@chatbotkit-dev/eslint-config": "workspace:*",
    "@chatbotkit-dev/jest-jsdom": "workspace:*",
    "@types/command-line-args": "^5.2.3",
    "eslint": "^9.0.0",
    "jest": "^29",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
