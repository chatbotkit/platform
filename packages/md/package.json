{
  "name": "@chatbotkit-dev/md",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./chat": {
      "import": "./src/chat.ts",
      "default": "./src/chat.ts"
    },
    "./convert": {
      "import": "./src/convert.ts",
      "default": "./src/convert.ts"
    },
    "./extract": {
      "import": "./src/extract.ts",
      "default": "./src/extract.ts"
    },
    "./frontmatter": {
      "import": "./src/frontmatter.ts",
      "default": "./src/frontmatter.ts"
    },
    "./linkify": {
      "import": "./src/linkify.ts",
      "default": "./src/linkify.ts"
    },
    "./split": {
      "import": "./src/split.ts",
      "default": "./src/split.ts"
    },
    "./table": {
      "import": "./src/table.ts",
      "default": "./src/table.ts"
    }
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc6 --emitDeclarationOnly",
    "check": "tsc6 --noEmit --incremental",
    "clean": "run-s clean:*",
    "clean:01-tsbuildinfo": "rimraf *.tsbuildinfo",
    "clean:02-dist": "rimraf dist",
    "clean:03-node_modules": "rimraf node_modules",
    "format": "true",
    "lint": "eslint src --ext .ts,.js",
    "test": "jest"
  },
  "access": "restricted",
  "types": "./types/src/index.d.ts",
  "dependencies": {
    "@chatbotkit-dev/regex": "workspace:*",
    "@chatbotkit-dev/yaml": "workspace:*",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^9.0.3",
    "remark-gfm": "^3.0.1",
    "remark-parse": "^10.0.2",
    "remark-rehype": "^10.1.0",
    "unified": "^10.1.2",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@chatbotkit-dev/eslint-config": "workspace:*",
    "@chatbotkit-dev/jest-jsdom": "workspace:*",
    "@types/jest": "^29.5.11",
    "@types/mdast": "^4.0.4",
    "eslint": "^9.0.0",
    "jest": "^29",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
