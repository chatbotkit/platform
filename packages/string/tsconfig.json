{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "target": "es2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "ES2021"
    ],
    "types": [
      "node",
      "jest"
    ],
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "rootDir": ".",
    "declaration": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.js"
  ]
}
