#
# ENV
#
# @note deployment identity is provider-neutral. Production is inferred from
# NODE_ENV=production when this is unset; staging deployments must set this.
# Setting `development` on a production build relaxes sign-in rate limits,
# logs sign-in codes and enables RUNAS_USERID - the server warns at boot;
# never do this on a public instance.
# TARGET_ENV=staging

#
# DATABASE
#
# A local SQLite file, provisioned with `pnpm db:push` (the Docker dev
# service does this automatically). Hosted deployments replace this with
# their database module's connection string.
#
PRISMA_DATABASE_URL=file:./.dev/platform.db
#
# Optional. Encrypts stored credentials in the database. Unset, they are
# stored as given. Generate one with `pnpm script:generate-encryption-key`;
# see docs/configuration.md, "Encryption at rest", for rotation. Losing the key
# loses every encrypted value.
#
# PRISMA_FIELD_ENCRYPTION_KEY=

#
# MEMCACHE
#
# REDIS_URL=redis://localhost:6379

#
# VECTOR
#
# Records live in local JSON files by default (VECTOR_DATA_DIR, .vector when
# unset). Point QDRANT_URL at a Qdrant server - the docker compose stands one
# up - to use a real index instead. Embedding needs OPENAI_API_KEY either way.
#
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# VECTOR_DATA_DIR=.vector

#
# STORAGE
#
# The storage module speaks the S3 protocol; unconfigured, the app runs and
# refuses storage features at the point of use. The docker compose stack
# stands up a provisioned local store (Garage) - these values point at it, so
# uncommenting them is all a host-side `pnpm dev` needs. Any S3-compatible
# store (AWS, R2, SeaweedFS) works with its own values; the bucket variables,
# STORAGE_PUBLIC_ENDPOINT (where browsers reach the store, when that
# differs from where the server does) and the sandbox-mount role are
# documented in packages/storage/README.md.
#
# STORAGE_ENDPOINT=http://localhost:3900
# STORAGE_REGION=garage
# STORAGE_ACCESS_KEY_ID=GK31e57eba9df26b2e7e1b0eaa
# STORAGE_SECRET_ACCESS_KEY=9f3c1e2b8a4d5f6071829304a5b6c7d8e9f00112233445566778899aabbccdde
# STORAGE_FORCE_PATH_STYLE=true
# FILE_S3_BUCKET_NAME=file
# IMAGE_S3_BUCKET_NAME=image
# VIDEO_S3_BUCKET_NAME=video
# AUDIO_S3_BUCKET_NAME=audio
# CONVERSATION_S3_BUCKET_NAME=conversation
# NAMESPACE_S3_BUCKET_NAME=namespace
# SESSION_S3_BUCKET_NAME=session
# SPACE_S3_BUCKET_NAME=space
# TEMP_S3_BUCKET_NAME=temp
# OUTPUT_S3_BUCKET_NAME=output

#
# RELAY
#
# Realtime channels (voice, avatars) meet at a relay speaking the channel
# protocol in packages/relay/README.md. Unconfigured, the app runs and refuses
# realtime features at the point of use. With RELAY_PORT set the server
# process hosts one itself (the relay module's `listen`), which is all a
# local stack needs - the docker compose stack sets both.
#
# RELAY_PORT=3001
# RELAY_URL=http://localhost:3001

#
# NEXT AUTH
#
# @note local sign-in needs no OAuth provider and no SMTP: the email provider
# is always available, and in development the 6-digit sign-in code is printed
# to the server log instead of relying on delivery. Enter any email address on
# the sign-in page and copy the code from the console. Set
# SKIP_VERIFICATION_REQUEST=true to skip the delivery attempt entirely.
#
NEXTAUTH_SECRET=dummy

NEXTAUTH_URL=https://dummy
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:8080

# @note presence-gated: setting these enables the matching sign-in provider,
# so leave them commented unless you have real credentials
# NEXTAUTH_GOOGLE_APP_ID=
# NEXTAUTH_GOOGLE_APP_SECRET=
# NEXTAUTH_GITHUB_APP_ID=
# NEXTAUTH_GITHUB_APP_SECRET=
# NEXTAUTH_AZURE_AD_CLIENT_ID=
# NEXTAUTH_AZURE_AD_CLIENT_SECRET=
# NEXTAUTH_AZURE_AD_TENANT_ID=

#
# NEXT
#
NEXT_TELEMETRY_DISABLED=1

#
# BUILT-IN ASSISTANTS AND PUBLIC EXAMPLES
#
# Authenticated dashboard and blueprint assistants use the signed-in account.
# AUTO_WIDGET_MODEL enables the built-in assistants and selects their language
# model. Public website and example widgets are disabled unless an operator
# supplies a service-account owner explicitly.
# AUTO_WIDGET_MODEL=gpt-5.4-mini
# AUTO_WIDGET_USER_ID=
# EXAMPLE_WIDGET_USER_ID=

# Shared with the separate portal frontend when it rewrites custom domains.
# Use at least 16 characters. Leave unset when no portal frontend is deployed;
# unsigned or invalid internal assertions are ignored.
# INTERNAL_HEADERS_SECRET=

# Trust x-forwarded-host, x-forwarded-proto and the client address (x-real-ip,
# else the last x-forwarded-for hop) from a trusted reverse proxy. Leave
# unset unless the proxy overwrites these headers and direct access to the
# application origin is blocked. This is explicit on every hosting provider.
# Behind a proxy it is also what keeps the sign-in rate limits per client
# rather than one shared bucket for everyone.
# TRUST_PROXY_HEADERS=true

# Optional deployment-wide safety ceiling. The community default is unlimited;
# hosted or resource-constrained operators can set a positive monthly token cap.
# PLATFORM_MAX_TOKENS_PER_MONTH=100000000

# Seconds an API key or OAuth token lookup may be served from cache during
# authentication. Unset or 0 reads the row on every request, so revocation is
# immediate; a positive value keeps a revoked credential working for up to
# that long in exchange for fewer database reads.
# PLATFORM_CREDENTIAL_CACHE_TTL=30

# Optional support contact. When set, the support page offers an email
# channel; when unset, the email option is not shown.
# SUPPORT_EMAIL=support@example.com

#
# QUEUE
#
# @note the delivery secret that lets trusted tooling call a queued route
# directly - the trigger scripts use it, and the local delivery path attaches it.
# It authenticates the platform to itself and has nothing to do with which queue
# is installed. Comma separated, so one can be rotated without downtime.
#
# Whichever queue is installed documents its own variables in its own README.
#
QUEUE_SECRET=dummy

# @note whichever queue is installed documents its own credentials in its own
# README. None of them are here: the runners the platform starts are given a
# scoped token for one route rather than a queue credential of their own.

#
# OPENAI
#
# @note OPENAI_MODELS_API_KEY is the canonical name, consistent with the
# other providers. OPENAI_API_KEY (the vendor's standard name) is honoured
# as a fallback by the model layer and is what the vector module reads for
# embeddings - setting the standard name alone covers both.
OPENAI_API_KEY=
OPENROUTER_MODELS_API_KEY=
VERCEL_MODELS_API_KEY=

# @note further model providers, all presence-gated - setting a key enables
# that provider's models and nothing else changes
# VERTEX_MODELS_API_KEY=
# BEDROCK_MODELS_API_KEY=
# BEDROCK_API_URL=
# CLOUDFLARE_MODELS_ACCOUNT_ID=
# CLOUDFLARE_MODELS_API_KEY=
# PERPLEXITY_MODELS_API_KEY=
# MISTRAL_MODELS_API_KEY=
# GROQ_MODELS_API_KEY=
# DEEPSEEK_MODELS_API_KEY=

#
# ANALYTICS
#
# @note presence-gated: setting a Google tag id enables the GTag integration;
# unset, no analytics load at all
# NEXT_PUBLIC_GTAG_ID=

#
# EXPERIENCE
#
# @note hostnames that serve the builder experience instead of the platform
# experience. Comma-separated; each entry is an exact hostname or a
# `*.example.com` wildcard (subdomains only). Unset, every host serves the
# platform experience.
# EXPERIENCE_BUILDER_HOSTS=

#
# SITE URL
#
SITE_URL=http://localhost:3000

# @note optional: the origin embed snippets and widget frames are served from,
# for deployments that front the embed scripts through a dedicated static
# host. Defaults to SITE_URL - the app serves the same paths itself.
# STATIC_URL=

# @note optional: the origin private MCP widget bundles are served from.
# Defaults to SITE_URL.
# WIDGET_URL=

# @note optional: the origin external API URLs (webhook registrations, embeds,
# the OpenAPI spec) point at. Defaults to SITE_URL - the API is served under
# /api on the site host. A dedicated origin (e.g. https://api.example.com) is
# also routed to the API by the deployment, so an API subdomain needs only
# this variable.
# API_URL=

#
# JWT
#
# @note signs session and widget tokens; at least 32 characters, and the
# dev-only- placeholder below is refused outside development. Generate a real
# value with `openssl rand -hex 32`.
#
JWT_TOKEN_SECRET_KEY=dev-only-jwt-secret-not-for-production-use-0000

#
# CLOAK ENCRYPTION
#
CLOAK_ENCRYPTION_KEY=dummy

#
# SECURITY HEADERS
#
# @note optional CSP report-uri injected into the security headers; any
# violation collector works. The community observability module logs to the
# console, so there is no error-tracking DSN to configure here.
# SENTRY_HEADERS_REPORT_URI=

#
# DEVELOPMENT SWITCHES
#
# @note presence-gated (any non-empty value): each disables a subsystem for
# local debugging or tests. The test scripts set the first three themselves.
# Never set any of these on a public instance - SKIP_LIMITS_CHECK in
# particular turns off every plan and quota check.
# SKIP_FUNCTION_CACHE=true
# SKIP_USAGE_RECORDING=true
# SKIP_LOG_RECORDING=true
# SKIP_LIMITS_CHECK=true
# SKIP_STATIC_GENERATION=true
# SKIP_STATIC_REVALIDATION=true
# @note act as a particular account in development only (see TARGET_ENV
# above); useful when reproducing something that depends on a user's data
# RUNAS_USERID=

#
# DEPLOYMENT CONFIGURATION (*_CONFIG)
#
# Five variables carry a JSON document rather than a scalar. They are
# operator-owned data - who administers this deployment, what it sells, what a
# plan grants, which hostnames it answers on, who gets exceptions and which
# paths belong to an external zone - kept out of the source tree so business
# models and routing topology are not code changes.
#
# ALL FIVE ARE OPTIONAL. Setting none of them is the supported self-hosted
# default, not a degraded mode: no administrators, no plans, no billing, no
# exceptions, no additional host mappings, no external zones, and everything
# served path-based on a single host.
#
# The four application values below use STRICT schemas when their config modules
# load. An unrecognised key, missing required key or malformed JSON fails rather
# than warning. ZONE_CONFIG is parsed separately when Next.js builds routing;
# invalid JSON or paths fail that build, and changes require a rebuild.
#
# See docs/configuration.md for the full shapes, the security
# implications of each, and the compatibility rules. The authoritative
# documentation is in the header of its parser in config/ or next.config.d/.
#
# Who reaches /admin. Entries are user ids or email addresses. Unset = nobody.
# ADMINS_CONFIG=["ops@example.com"]
#
# The plan catalogue - one COMPLETE limit table per plan name. Unset = no plan
# concept at all (every limit unlimited, no plan names anywhere), which is a
# working configuration rather than an empty one. No example here on purpose:
# the schema is strict and a table must carry EVERY limit key, so an abbreviated
# one would not boot. Start from the shape documented in config/limits.ts.
# LIMITS_CONFIG=
#
# Per-account exceptions and plan grants. Use account ids for limits and VIP;
# enforcement does not consistently apply email-keyed limit entries. Plan
# grants are email-keyed. A grant must name a LIMITS_CONFIG plan other than
# free/trial, or the implicit unlimited plan.
# OVERRIDES_CONFIG={"clxyz0000000000000000000n":{"limits":{"database":{"files":300}}}}
#
# Apexes beneath which deployment-issued subdomains are created. Each is
# optional; an unset apex disables that dedicated hostname pattern.
# APP_APEX=example.app
# PORTAL_APEX=example.agency
# SPACE_APEX=example.site
# PARTNERS_APEX=example.partners
#
# Canonical app-shell origins. The main shell remains path-based when unset;
# the Labs shell exists only when APP_LABS_ORIGIN is set.
# APP_MAIN_ORIGIN=https://apps.example.com
# APP_LABS_ORIGIN=https://labs.example.com
#
# Optional request-affine host mappings. SITE_URL remains the canonical and
# requestless default. Every value is a hostname without a protocol or path.
# HOSTS_CONFIG={"example":{"match":["example.com","api.example.com","static.example.com","widgets.example.com"],"site":"example.com","api":"api.example.com","static":"static.example.com","widgets":"widgets.example.com"}}
#
# Optional build-time multi-zone routing. Each active zone needs an origin and
# at least one exact host. See docs/configuration.md for path ownership rules.
# ZONE_CONFIG=[{"origin":"https://marketing.example.com","hosts":["example.com"],"root":true,"paths":["/pricing"],"assetPrefix":"/marketing-static"}]
