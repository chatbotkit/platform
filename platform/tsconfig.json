{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "composite": false, // @todo not ready yet
    "target": "es2019",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "webworker"
    ],
    "types": [
      "node",
      "jest"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false, // @todo not ready yet
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "strictNullChecks": true,
    "noImplicitOverride": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "next.config.d/*.js",
    "i18n.config.js",
    "flags.config.js",
    "lib/*.js",
    "lib/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/lib.js",
    "app/**/route.js",
    "pages/api/**/*.js",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "bootstrap/*.js",
    "components/*.js",
    "components/*.jsx",
    "emails/*.jsx",
    "hooks/*.jsx",
    "layouts/*.jsx",
    "templates/*.js",
    "prisma/**/*.js",
    "prisma/**/*.ts",
    "schemas/*.js",
    "config/*.js",
    "tests/**/*.js",
    "scripts/*.js",
    "polyfills/*.js",
    "workers/*.js",
    "widgets/*.js",
    "schemas/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public"
  ]
}
