    "script:print-env": "tsx scripts/print-env.js",
    "script:print-system": "tsx scripts/print-system.js",
    "script:rename-user-email": "tsx scripts/rename-user-email.js",
    "script:reset-usage": "tsx scripts/reset-usage.js",
    "script:run-db-placeholder": "tsx scripts/run-db-placeholder.js",
    "script:create-team": "tsx scripts/create-team.js",
    "script:run-proxy": "tsx scripts/run-proxy.js",
    "script:explore-sandbox": "tsx scripts/explore-sandbox.js",
    "script:prisma-query": "tsx scripts/prisma-query.js",
    "script:setup-prisma-client": "tsx scripts/setup-prisma-client.js",
    "script:show-conversation": "tsx scripts/show-conversation.js",
    "script:simulate-conversation": "pnpm run with-env next tsx:yaml scripts/simulate-conversation.js",
