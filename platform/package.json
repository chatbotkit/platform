  "scripts": {
    "browsers:update": "pnpm up -r caniuse-lite browserslist",
    "build": "run-s build:*",
    "build-storybook": "storybook build",
    "build:00-print_env": "pnpm script:print-env",
    "build:00-print_system": "pnpm script:print-system",
    "build:01-db_schema": "true",
    "build:02-db_client": "pnpm db:gen",
    "build:02-graphql_gen": "pnpm graphql:gen",
    "build:03-templates": "pnpm script:build-templates",
    "build:04-test_unit": "if [ \"$SKIP_BUILD_TESTS\" = \"true\" ]; then echo 'skipping unit tests (SKIP_BUILD_TESTS=true)'; else pnpm test:unit; fi",
    "build:05-api_spec": "pnpm script:build-api-spec",
    "build:08-dev-pages": "rimraf pages/_",
    "build:09-next": "next build --webpack",
    "build:09-verify_bundle": "tsx scripts/verify-bundle-modules.js",
    "build:10-sitemap": "next-sitemap",
    "check": "node ./node_modules/typescript7/bin/tsc --noEmit --incremental --singleThreaded --diagnostics",
    "clean": "run-s clean:*",
    "clean:00-next": "rimraf .next",
    "clean:01-tsbuildinfo": "rimraf *.tsbuildinfo",
    "clean:02-dist": "rimraf dist",
    "clean:03-node_modules": "rimraf node_modules",
    "tsx": "tsx",
    "tsx:yaml": "tsx --import ./scripts/yaml-esm-register.mjs",
    "db": "pnpm db:push && pnpm db:gen",
    "db:gen": "pnpm script:setup-prisma-client",
    "db:push": "tsx scripts/db-push.js",
    "db:seed": "tsx scripts/seed-db.js",
    "dev": "run-p dev:*",
    "dev:02-next": "next dev --webpack -p ${APP_PORT:-8080} 2>&1 | tee /tmp/next.log",
    "dev:03-proxy": "if [ -n \"$PROXY_HOST\" ]; then pnpm script:run-proxy 2>&1 | tee /tmp/proxy.log; fi",
    "email:dev": "email dev -p ${EMAIL_PORT:-8082}",
    "with-env": "tsx scripts/run-with-environment.js",
    "format": "run-s format:*",
    "graphql:gen": "graphql-codegen --require tsconfig-paths/register --config codegen.ts",
    "lint": "run-s lint:*",
    "lint:next": "eslint --ext .js,.jsx,.ts,.tsx pages app components layouts lib",
    "lint:scripts": "eslint 'scripts/**/*.{js,ts}'",
