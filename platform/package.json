    "script:cleanup-expired-conversations": "tsx scripts/cleanup-expired-conversations.js",
    "script:count-tokens": "tsx scripts/count-tokens.js",
    "script:decrypt": "tsx --experimental-global-webcrypto scripts/decrypt.js",
    "script:delete-bot": "tsx scripts/delete-bot.js",
    "script:delete-dataset": "tsx scripts/delete-dataset.js",
    "script:delete-skillset": "tsx scripts/delete-skillset.js",
    "script:delete-user": "tsx scripts/delete-user.js",
    "script:delete-users-by-domain": "pnpm tsx:yaml scripts/delete-users-by-domain.js",
