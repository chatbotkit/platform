    "script:list-recent-usage": "tsx scripts/list-recent-usage.js",
    "script:list-space-storage": "tsx scripts/list-space-storage.js",
    "script:test-mcp-server": "tsx -C import --experimental-global-webcrypto scripts/test-mcp-server.js",
    "script:trigger-clock-10": "tsx scripts/trigger-clock-10.js",
    "script:trigger-conversation-idle": "tsx scripts/trigger-conversation-idle.js",
    "script:trigger-dataset-cleanup": "tsx scripts/trigger-dataset-cleanup.js",
    "script:trigger-task-schedule": "tsx scripts/trigger-task-schedule.js",
    "script:trigger-task-trigger": "tsx scripts/trigger-task-trigger.js",
    "script:trigger-task-stalled": "tsx scripts/trigger-task-stalled.js",
